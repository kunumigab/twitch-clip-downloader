{
  "twitch": {
    "client_id": "TU_CLIENT_ID",
    "client_secret": "TU_CLIENT_SECRET",
    "channels": ["nombre_del_canal"]
  },
  "default_since_days": 30,
  "max_per_channel": 0,

  "storage": "local",
  "output_dir": "output",

  "youtube": {
    "client_id": "TU_YOUTUBE_CLIENT_ID",
    "client_secret": "TU_YOUTUBE_CLIENT_SECRET",
    "tokens_file": "youtube_tokens.json",
    "privacy_status": "private",
    "auto_upload": false,
    "title_template": "{title} | {channel}",
    "channel_map": {
      "nombre_del_canal_twitch": "perfil_youtube"
    }
  },

  "s3": {
    "endpoint_url": "https://s3.us-east-1.amazonaws.com",
    "bucket": "mi-bucket",
    "prefix": "twitch-clips",
    "region": "us-east-1",
    "access_key_id": "TU_ACCESS_KEY",
    "secret_access_key": "TU_SECRET_KEY",
    "keep_local": false
  }
}
